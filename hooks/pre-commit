#!/bin/sh
# Checks staged Python files with ruff (format and lint), then type checks the
# project with pyright. Enable once per clone:
#
#   git config core.hooksPath hooks
#
# Checks rather than reformats: the commit then contains exactly what was
# staged. (Auto-formatting would have to `git add` whole files, which would
# sweep in any hunks deliberately left unstaged by `git add -p`.) pyright runs
# on the whole project, not just the staged files: a change in one module can
# break the types of another.

set -e

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
[ -z "$staged" ] && exit 0

if [ -x .venv/bin/ruff ] && [ -x .venv/bin/pyright ]; then
    bin=.venv/bin/
elif command -v ruff >/dev/null && command -v pyright >/dev/null; then
    bin=""
else
    echo "pre-commit: ruff/pyright not found, skipping checks."
    echo "            install them with: uv pip install -e '.[dev]'"
    exit 0
fi

# --check against the working tree, not the index: a staged file with further
# unstaged edits is checked as it currently reads on disk.
if ! "${bin}ruff" format --check --quiet $staged || ! "${bin}ruff" check --quiet $staged; then
    echo
    echo "commit aborted: staged files are not formatted or fail lint. Run"
    echo "  ${bin}ruff check --fix src tests scripts && ${bin}ruff format src tests scripts"
    echo "then fix anything left and re-stage."
    exit 1
fi

if ! "${bin}pyright" >/dev/null; then
    "${bin}pyright" | tail -20
    echo
    echo "commit aborted: pyright found type errors (above). Run ${bin}pyright to see them all."
    exit 1
fi
